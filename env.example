# Base URLs
BASE_URL=https://brimerchant.bri.co.id
LOGIN_URL=https://brimerchant.bri.co.id/auth/login
MUTASI_URL=https://brimerchant.bri.co.id/transaksi/daftar-transaksi/ganti-url-valid-anda

# Authentication credentials
LOGIN_PHONE=yourphone
PASSWORD=your-password

# Webhook configuration
WEBHOOK_URL=http://localhost:8080/webhook/mutasi

# Browser settings
TIMEZONE=Asia/Jakarta
HEADLESS=true
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Polling configuration
POLL_SECONDS=120

# File paths
SESSION_FILE=./data/session.json
CACHE_DB=./data/sent_ids.sqlite

# Debug (optional - uncomment to customize)
# DEBUG_SCREENSHOT=./data/debug_last.png
# DEBUG_HTML=./data/debug_last.html

CRON_INTERVAL_MINUTES=2
