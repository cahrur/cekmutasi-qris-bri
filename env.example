# Base URLs
BASE_URL=https://brimerchant.bri.co.id
LOGIN_URL=https://brimerchant.bri.co.id/auth/login
MUTASI_URL=https://brimerchant.bri.co.id/transaksi

# Authentication credentials
LOGIN_PHONE=yourphone
PASSWORD=your-password

# Webhook configuration
WEBHOOK_URL=http://localhost:8080/webhook/mutasi

# Browser settings
TIMEZONE=Asia/Jakarta
HEADLESS=true
# WAJIB 'chromium'. WAF (Incapsula) di depan BRI Merchant memblokir headless shell
# bawaan Playwright sehingga halaman login tidak pernah ter-render.
# Kosongkan hanya jika ingin memakai build bawaan Playwright.
BROWSER_CHANNEL=chromium
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Polling configuration
POLL_SECONDS=120

# File paths
SESSION_FILE=./data/session.json
CACHE_DB=./data/sent_ids.sqlite

# Debug (optional). Set true untuk menyimpan screenshot + HTML halaman ke ./data/
# saat login/scraping gagal. Nama variabelnya DEBUG_SCREENSHOTS (pakai S).
# DEBUG_SCREENSHOTS=true

CRON_INTERVAL_MINUTES=2

# Jam jeda - bot tidak scraping di rentang ini (format 24 jam HH:MM).
# Mengikuti TIMEZONE di atas, jadi tidak terpengaruh zona waktu server.
# Kosongkan keduanya untuk menonaktifkan.
#
# PENTING: halaman BRI Merchant hanya menampilkan transaksi HARI INI, jadi jeda
# yang melewati tengah malam akan kehilangan transaksi. Contoh 23:00-02:00 membuat
# transaksi jam 23:00-23:59 tidak pernah terkirim. Mulai jeda dari 00:00 agar aman.
QUIET_HOURS_START=00:00
QUIET_HOURS_END=02:00
